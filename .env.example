# Database (Neon.tech) — ambil dari Neon Console -> Connection Details -> Connection string
# Bentuknya: postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/sultan_laundry?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/sultan_laundry?sslmode=require

# Set true kalau DATABASE_URL bukan dari Neon tapi tetap wajib SSL (jarang perlu diubah)
DB_SSL=true

# Auth
JWT_SECRET=ganti-dengan-random-string-panjang-dan-rahasia
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# CORS - domain GitHub Pages Anda (tanpa trailing slash). Kalau ada 2 frontend
# (app pelanggan + dashboard admin) beda origin, pisahkan dengan koma.
FRONTEND_ORIGIN=https://USERNAME.github.io

# Fonnte WhatsApp Gateway (isi setelah punya token, dipakai untuk OTP & notifikasi status)
FONNTE_TOKEN=

# Ambang batas selisih harga estimasi vs final yang wajib konfirmasi ulang ke pelanggan (%)
PRICE_DEVIATION_THRESHOLD=20

# Push Notification (Firebase Cloud Messaging)
# Set true setelah taruh serviceAccountKey.json di root backend (lihat src/utils/notify.js)
FIREBASE_ENABLED=false
